# AI assistant backend (npm run ai:server). Copy to `.env` and fill ONE key.
# The key is read only by server/ai-server.ts — never prefix it with VITE_
# (VITE_ variables are bundled into browser code).

# anthropic | openai — optional; picked automatically from the key you set
AI_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_PORT=8787
AI_TIMEOUT_MS=20000

# Browser side: set to "off" to never call the server (pure local assistant).
VITE_AI_SERVER=on

# ── Lab server (npm run server) ───────────────────────────
# One server serves the AI routes and the accounts API on this port
# (Vite proxies /api here in dev and preview).
SERVER_PORT=8787
# SQLite database file (created on first start; never commit it)
DB_FILE=data/lab.db
# Session length in hours (httpOnly cookie)
SESSION_TTL_HOURS=12
# true behind HTTPS (hosting, after V2-12); false for local http://localhost
COOKIE_SECURE=false
# Origins allowed to send state-changing requests (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# The first admin is created with: npm run server:create-admin
# (you type the password; it is never written into any file)

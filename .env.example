# AI keys for the lab server (npm run server). Copy this file to `.env`.
# Keys are read only by the server (server/bit.ts, server/ai.ts) — never
# prefix them with VITE_ (VITE_ variables are bundled into browser code),
# and never commit `.env` (it is in .gitignore).

# ── Bit, the voice assistant (Google Gemini) ──────────────
# Get a key at https://aistudio.google.com/apikey and paste it after "=".
# Without it Bit still answers its built-in questions, opens sections,
# runs the site tour and the lessons; only free questions need Gemini.
GEMINI_API_KEY=
# A fast model keeps the first spoken word quick (gemini-2.5-flash is retired for new keys).
# gemini-3.5-flash: first word in ~1 s, clean Kazakh; gemini-3.8-flash: a little finer wording, ~3 s.
GEMINI_MODEL=gemini-3.5-flash
# How much the model thinks before answering. Empty = as little as the model allows
# (Gemini 3: minimal / low; 2.x: 0). Or a level (low, medium, high), a number, or "default".
GEMINI_THINKING=
# Bit's voice (0.37): Gemini speech synthesis, tried in order when one model's quota is used up.
# The free tier allows only ~10 speech requests a day per model; enable billing for a whole class.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Speech recognition (Kazakh is recognised on the server; default: GEMINI_MODEL)
# GEMINI_STT_MODEL=gemini-3.5-flash
# Synthesised sentences are kept here across restarts (default data/voice-cache)
# BIT_VOICE_CACHE_DIR=data/voice-cache

# ── Setup assistant (PC builds in Setup Studio) ───────────
# gemini | anthropic | openai — optional; picked from the key you set
# (with GEMINI_API_KEY above, Gemini serves this assistant too)
AI_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_PORT=8787
AI_TIMEOUT_MS=20000

# Browser side: set to "off" to never call the server (pure local assistant).
VITE_AI_SERVER=on

# ── Lab server (npm run server) ───────────────────────────
# One server serves the AI routes and the accounts API on this port
# (Vite proxies /api here in dev and preview).
SERVER_PORT=8787
# SQLite database file (created on first start; never commit it)
DB_FILE=data/lab.db
# Session length in hours (httpOnly cookie)
SESSION_TTL_HOURS=12
# true behind HTTPS (hosting, after V2-12); false for local http://localhost
COOKIE_SECURE=false
# Origins allowed to send state-changing requests (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# The first admin is created with: npm run server:create-admin
# (you type the password; it is never written into any file)

# Database backups (admin panel → Backups); default: a 'backups' folder next to DB_FILE
# BACKUP_DIR=data/backups
# Whose X-Forwarded-For header to trust for client IPs (rate limits, IP blocks):
# loopback (default: the Vite proxy / a reverse proxy on this machine), none, all
TRUST_PROXY=loopback

# ── Production (V2-12, DEPLOY.md) ─────────────────────────
# Your domain, without https:// (docker-compose gives it to Caddy for HTTPS)
# DOMAIN=lab.example.kz
# then also: COOKIE_SECURE=true and ALLOWED_ORIGINS=https://lab.example.kz
# Interface the server listens on: 127.0.0.1 (default, this machine only);
# docker-compose sets 0.0.0.0 inside its private network
# HOST=127.0.0.1
# Serve the built site (dist/) from this server too (npm run serve:prod sets it)
# STATIC_DIR=dist

{
  "name": "virtual-informatics-lab-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Оқушыларға арналған виртуалды информатика зертханасы — VIRTUAL INFORMATICS LAB 3D",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-decoders.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "perf": "node scripts/perf-measure.mjs",
    "test:assembly": "node --experimental-strip-types --test scripts/assembly.test.mjs",
    "test:assistant": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/assistant.test.mjs",
    "test:pc-lab": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/assembly-lab.test.mjs",
    "test:network": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/network.test.mjs",
    "test:grading": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/grading.test.mjs",
    "test:algorithms": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/algorithms.test.mjs",
    "test:logic": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/logic.test.mjs",
    "test:experiments": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/experiments.test.mjs",
    "test:progress": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/progress.test.mjs",
    "ai:server": "node --experimental-strip-types --import ./scripts/test-resolve.mjs server/ai-server.ts",
    "test:devices": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/devices.test.mjs",
    "test:teardown": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/teardown.test.mjs",
    "test:lab": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/lab-space.test.mjs",
    "test:ai": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/ai.test.mjs",
    "test": "npm run test:ai && npm run test:assistant && npm run test:assembly && npm run test:pc-lab && npm run test:progress && npm run test:network && npm run test:grading && npm run test:algorithms && npm run test:logic && npm run test:experiments && npm run test:lab && npm run test:devices && npm run test:teardown && npm run test:blender && npm run test:visual",
    "test:blender": "node --test scripts/blender-pipeline.test.mjs",
    "blender:pipeline": "node scripts/blender/run.mjs",
    "test:visual": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/visual.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.51.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3d": "^1.5.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}

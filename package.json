{
  "name": "virtual-informatics-lab-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Оқушыларға арналған виртуалды информатика зертханасы — VIRTUAL INFORMATICS LAB 3D",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-decoders.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "test:assembly": "node --experimental-strip-types --test scripts/assembly.test.mjs",
    "test:assistant": "node --experimental-strip-types --import ./scripts/test-resolve.mjs --test scripts/assistant.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.51.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3d": "^1.5.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}

    "@react-three/postprocessing": "^3.1.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.51.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
